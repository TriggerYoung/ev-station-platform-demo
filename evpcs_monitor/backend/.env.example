# 复制本文件为同目录下的 `.env` 并填写真实值（`.env` 已被 Git 忽略）。
# `app.py` 启动时会通过 python-dotenv 自动加载 `.env`。

# MySQL (Flask CRUD / 业务数据)
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=evpcs

# InfluxDB 2.x（时序数据大屏等）
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influx_admin_token
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=charging_data

# 可选：若自行恢复新浪新闻爬虫，请仅在本地设置会话 Cookie，切勿提交到 Git
# SINA_NEWS_COOKIE=
