# 复制本文件为同目录下的 `.env` 并填写真实值（`.env` 已被 Git 忽略）。
# `app.py` 启动时会通过 python-dotenv 自动加载 `.env`。

# MySQL (Flask CRUD / 业务数据)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=evpcs

# 本地演示账号共用密码；只写入本机 .env，不要在仓库中提交真实密码
DEMO_USER_PASSWORD=choose_a_local_demo_password

# InfluxDB 2.x（时序数据大屏等）
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influx_admin_token
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=charging_data

# 数据预处理阶段用于逆地理编码；仅后端脚本读取，不要提交真实 Key
TENCENT_MAP_KEY=your_tencent_map_key

# 可选：若自行恢复新浪新闻爬虫，请仅在本地设置会话 Cookie，切勿提交到 Git
# SINA_NEWS_COOKIE=
